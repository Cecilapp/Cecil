{# all "showable pages by default #}
{% set pages = site.pages.showable %}
{# in case of a list page, take its sub pages #}
{% if page.pages is defined %}
  {%- set pages = page.pages -%}
{% endif %}
{# in case of a paginated list page, take the paginator list pages #}
{% if page.paginator.pages is defined %}
  {%- set pages = page.paginator.pages -%}
{% endif %}
{# dates are displayed if pages are sorted by date #}
{% set sortby = page.sortby|default(config.pages.sortby) %}
{% set show_date = (sortby is iterable ? sortby.variable|default('date') : sortby) == 'date' %}

{% extends ['page.html.twig', '_default/page.html.twig'] %}

      {%- block content ~%}
      {%- if page.type != 'homepage' ~%}
      <header>
        <h1>{{ page.title }}</h1>
      </header>
      {%- endif ~%}
      {%- if page.content ~%}
      <section>
        {{- page.content ~}}
      </section>
      {%- endif ~%}
      {%- for p in pages ~%}
      <article class="list-item">
        <h2><a href="{{ url(p) }}">{{ p.title|e }}</a></h2>
        {%- if show_date and p.date is defined and p.date ~%}
        <time datetime="{{ p.date|date('c') }}">{{ p.date|format_date('long') }}</time>
        {%- endif ~%}
        {%- if p.description|default ~%}
        <p>{{ p.description|e }}</p>
        {%- endif ~%}
      </article>
      {%- endfor ~%}
      {{- include('partials/paginator.html.twig', {page: page}, with_context=false) ~}}
      {%- endblock content ~%}