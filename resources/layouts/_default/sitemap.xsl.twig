<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9" version="3.0">
  <xsl:output method="html" version="1.0" encoding="utf-8" indent="yes" />
  <xsl:template match="/">
    <html xmlns="http://www.w3.org/1999/xhtml" lang="{{ site.language }}">
      <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>Sitemap - {{ site.title }}</title>
        <style type="text/css">
          :root {
            color-scheme: light dark;
            --bg: #F6F7F9;
            --surface: #FFFFFF;
            --text: #4B5563;
            --muted: #6B7280;
            --heading: #111827;
            --accent: #EA6A1A;
            --accent-soft: #FDEBDD;
            --link: #1D4ED8;
            --border: #E5E7EB;
            --shadow: 0 1px 2px rgb(0 0 0 / .04), 0 4px 16px rgb(0 0 0 / .04);
            --radius: .75rem;
          }
          @media (prefers-color-scheme: dark) {
            :root {
              --bg: #0F1115;
              --surface: #171A21;
              --text: #A7AFBC;
              --muted: #7D8590;
              --heading: #F0F3F6;
              --accent: #F5893D;
              --accent-soft: #3A2414;
              --link: #7AB0FF;
              --border: #262B34;
              --shadow: none;
            }
          }
          *, *::before, *::after {
            box-sizing: border-box;
          }
          html {
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
          }
          body {
            margin: 0;
            padding: clamp(1rem, 4vw, 3rem) 1rem;
            background: var(--bg);
            color: var(--text);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 1rem;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
          }
          main {
            max-width: 44rem;
            margin: 0 auto;
          }
          a {
            color: var(--link);
            text-decoration: none;
          }
          a:hover {
            text-decoration: underline;
            text-underline-offset: .2em;
          }
          a:focus-visible, input:focus-visible, button:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
          }
          header {
            margin-bottom: 2rem;
          }
          .badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .2rem .65rem .2rem .45rem;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: .8125rem;
            font-weight: 600;
            letter-spacing: .02em;
          }
          .badge svg {
            width: 1rem;
            height: 1rem;
          }
          h1 {
            margin: .75rem 0 .25rem;
            color: var(--heading);
            font-size: clamp(1.75rem, 5vw, 2.25rem);
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -.02em;
          }
          h1 a {
            color: inherit;
          }
          .description {
            margin: 0;
            color: var(--muted);
            font-size: 1.0625rem;
          }
          .subscribe {
            margin-top: 1.5rem;
            padding: 1.25rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--surface);
            box-shadow: var(--shadow);
          }
          .subscribe p {
            margin: 0 0 .75rem;
          }
          .subscribe label {
            display: block;
            margin-bottom: .35rem;
            color: var(--heading);
            font-size: .875rem;
            font-weight: 600;
          }
          .field {
            display: flex;
            gap: .5rem;
          }
          .subscribe input {
            flex: 1;
            min-width: 0;
            padding: .6rem .75rem;
            border: 1px solid var(--border);
            border-radius: .5rem;
            background: var(--bg);
            color: var(--heading);
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: .875rem;
          }
          .copy {
            flex: none;
            padding: .6rem 1rem;
            border: 0;
            border-radius: .5rem;
            background: var(--accent);
            color: #FFFFFF;
            font: inherit;
            font-size: .875rem;
            font-weight: 600;
            cursor: pointer;
            transition: filter .15s ease;
          }
          .copy:hover {
            filter: brightness(1.08);
          }
          .copy.copied {
            background: #16A34A;
          }
          h2 {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin: 0 0 .75rem;
            color: var(--heading);
            font-size: 1.125rem;
            font-weight: 600;
          }
          .count {
            padding: 0 .5rem;
            border-radius: 999px;
            background: var(--border);
            color: var(--muted);
            font-size: .75rem;
            font-weight: 600;
            line-height: 1.5rem;
          }
          ol {
            margin: 0;
            padding: 0;
            list-style: none;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--surface);
            box-shadow: var(--shadow);
            overflow: hidden;
          }
          li + li {
            border-top: 1px solid var(--border);
          }
          li a {
            display: block;
            padding: .9rem 1.25rem;
            transition: background-color .15s ease;
          }
          li a:hover {
            background: var(--bg);
            text-decoration: none;
          }
          li h3 {
            margin: 0;
            color: var(--heading);
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.4;
          }
          li a:hover h3 {
            color: var(--link);
          }
          li time {
            display: block;
            margin-top: .15rem;
            color: var(--muted);
            font-size: .8125rem;
            font-variant-numeric: tabular-nums;
          }
          footer {
            margin-top: 2rem;
            color: var(--muted);
            font-size: .8125rem;
            text-align: center;
          }
          @media (prefers-reduced-motion: reduce) {
            li a, .copy {
              transition: none;
            }
          }
          li a {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
          }
          li .loc {
            min-width: 0;
            color: var(--heading);
            font-size: .9375rem;
            overflow-wrap: anywhere;
          }
          li a:hover .loc {
            color: var(--link);
          }
          li time {
            flex: none;
            margin-top: 0;
          }
        </style>
      </head>
      <body>
        <main>
          <header>
            <span class="badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="3" width="6" height="5" rx="1" />
                <rect x="3" y="16" width="6" height="5" rx="1" />
                <rect x="15" y="16" width="6" height="5" rx="1" />
                <path d="M12 8v4M6 16v-4h12v4" />
              </svg>
              Sitemap
            </span>
            <h1><a href="{{ url(site.home, {canonical: true}) }}">{{ site.title }}</a></h1>
            {%- if site.description|default ~%}
            <p class="description">{{ site.description }}</p>
            {%- endif ~%}
            <div class="subscribe">
              <label for="sitemap-url">{% trans %}Sitemap URL:{% endtrans %}</label>
              <div class="field">
                <input id="sitemap-url" onclick="this.select();">
                  <xsl:attribute name="type">url</xsl:attribute>
                  <xsl:attribute name="readonly">readonly</xsl:attribute>
                  <xsl:attribute name="spellcheck">false</xsl:attribute>
                  <xsl:attribute name="value">{{ url('sitemap.xml', {canonical: true}) }}</xsl:attribute>
                </input>
                <button type="button" class="copy" data-target="sitemap-url" data-copied="{% trans %}Copied!{% endtrans %}">{% trans %}Copy{% endtrans %}</button>
              </div>
            </div>
          </header>
          <section>
            <h2>{% trans %}List of URLs{% endtrans %} <span class="count"><xsl:value-of select="count(sitemap:urlset/sitemap:url)" /></span></h2>
            <ol>
              <xsl:for-each select="sitemap:urlset/sitemap:url">
              <li>
                <a>
                  <xsl:attribute name="href"><xsl:value-of select="sitemap:loc" /></xsl:attribute>
                  <span class="loc"><xsl:value-of select="sitemap:loc" /></span>
                  <xsl:if test="sitemap:lastmod">
                    <time><xsl:attribute name="datetime"><xsl:value-of select="sitemap:lastmod" /></xsl:attribute><xsl:value-of select="substring(sitemap:lastmod, 1, 10)" /></time>
                  </xsl:if>
                </a>
              </li>
              </xsl:for-each>
            </ol>
          </section>
        </main>
        <script>
          <![CDATA[
          document.querySelectorAll('.copy').forEach(function (button) {
            var label = button.textContent;
            button.addEventListener('click', function () {
              var input = document.getElementById(button.dataset.target);
              var done = function () {
                button.textContent = button.dataset.copied;
                button.classList.add('copied');
                setTimeout(function () {
                  button.textContent = label;
                  button.classList.remove('copied');
                }, 2000);
              };
              if (navigator.clipboard) {
                navigator.clipboard.writeText(input.value).then(done);
              } else {
                input.select();
                document.execCommand('copy');
                done();
              }
            });
          });
          // localized dates
          if (window.Intl) {
            var format = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { dateStyle: 'medium', timeZone: 'UTC' });
            document.querySelectorAll('time[datetime]').forEach(function (time) {
              var value = time.getAttribute('datetime');
              var iso = value.match(/^(\d{4})-(\d{2})-(\d{2})/);
              var date = iso ? new Date(Date.UTC(iso[1], iso[2] - 1, iso[3])) : new Date(value + ' UTC');
              if (!isNaN(date)) {
                time.textContent = format.format(date);
              }
            });
          }
          ]]>
        </script>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>