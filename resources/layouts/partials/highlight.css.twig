{# Highlight code CSS ~#}
{%- set highlight_engine = config.pages.body.highlight.engine ?? 'highlightjs' ~%}
      /* Atom One Light / Atom One Dark colors (dark colors follow the color scheme and the theme selector) */
      :root {
        --cecil-hl-base: #383a42;
        --cecil-hl-comment: #a0a1a7;
        --cecil-hl-keyword: #a626a4;
        --cecil-hl-red: #e45649;
        --cecil-hl-cyan: #0184bb;
        --cecil-hl-green: #50a14f;
        --cecil-hl-orange: #986801;
        --cecil-hl-blue: #4078f2;
        --cecil-hl-yellow: #c18401;
      }
      @media only screen and (prefers-color-scheme: dark) {
        :root:not([data-theme=light]) {
          --cecil-hl-base: #abb2bf;
          --cecil-hl-comment: #5c6370;
          --cecil-hl-keyword: #c678dd;
          --cecil-hl-red: #e06c75;
          --cecil-hl-cyan: #56b6c2;
          --cecil-hl-green: #98c379;
          --cecil-hl-orange: #d19a66;
          --cecil-hl-blue: #61aeee;
          --cecil-hl-yellow: #e6c07b;
        }
      }
      [data-theme=dark] {
        --cecil-hl-base: #abb2bf;
        --cecil-hl-comment: #5c6370;
        --cecil-hl-keyword: #c678dd;
        --cecil-hl-red: #e06c75;
        --cecil-hl-cyan: #56b6c2;
        --cecil-hl-green: #98c379;
        --cecil-hl-orange: #d19a66;
        --cecil-hl-blue: #61aeee;
        --cecil-hl-yellow: #e6c07b;
      }
{%- if highlight_engine == 'tempest' ~%}
      /* tempest/highlight */
      .hl-keyword {
        color: var(--cecil-hl-keyword);
      }
      .hl-property {
        color: var(--cecil-hl-blue);
      }
      .hl-type {
        color: var(--cecil-hl-yellow);
      }
      .hl-generic {
        color: var(--cecil-hl-orange);
      }
      .hl-value {
        color: var(--cecil-hl-green);
      }
      .hl-variable {
        color: var(--cecil-hl-red);
      }
      .hl-comment,
      .hl-comment span {
        color: var(--cecil-hl-comment);
        font-style: italic;
      }
      .hl-attribute,
      .hl-em {
        font-style: italic;
      }
      .hl-strong {
        font-weight: bold;
      }
      .hl-blur {
        filter: blur(2px);
      }
      .hl-addition {
        background-color: #00ff0033;
      }
      .hl-deletion {
        background-color: #ff000022;
      }
      .hl-gutter {
        display: inline-block;
        margin-right: 1ch;
        padding: 0 1ch;
        color: var(--cecil-hl-comment);
      }
{%- else ~%}
      /* highlight.js, by Daniel Gamage */
      .hljs {
        color: var(--cecil-hl-base);
      }
      .hljs-comment,
      .hljs-quote {
        color: var(--cecil-hl-comment);
        font-style: italic;
      }
      .hljs-doctag,
      .hljs-keyword,
      .hljs-formula {
        color: var(--cecil-hl-keyword);
      }
      .hljs-section,
      .hljs-name,
      .hljs-selector-tag,
      .hljs-deletion,
      .hljs-subst {
        color: var(--cecil-hl-red);
      }
      .hljs-literal {
        color: var(--cecil-hl-cyan);
      }
      .hljs-string,
      .hljs-regexp,
      .hljs-addition,
      .hljs-attribute,
      .hljs-meta .hljs-string {
        color: var(--cecil-hl-green);
      }
      .hljs-attr,
      .hljs-variable,
      .hljs-template-variable,
      .hljs-type,
      .hljs-selector-class,
      .hljs-selector-attr,
      .hljs-selector-pseudo,
      .hljs-number {
        color: var(--cecil-hl-orange);
      }
      .hljs-symbol,
      .hljs-bullet,
      .hljs-link,
      .hljs-meta,
      .hljs-selector-id,
      .hljs-title {
        color: var(--cecil-hl-blue);
      }
      .hljs-built_in,
      .hljs-title.class_,
      .hljs-class .hljs-title {
        color: var(--cecil-hl-yellow);
      }
      .hljs-emphasis {
        font-style: italic;
      }
      .hljs-strong {
        font-weight: bold;
      }
      .hljs-link {
        text-decoration: underline;
      }
{%- endif ~%}