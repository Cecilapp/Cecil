{#- tabs: one tab per `####` heading, displayed as stacked panels (interactivity is left to the theme) ~#}
<div class="note note-{{ note.type|e }}" id="{{ note.id|e }}">
  {%~ if note.items is empty %}
  {{ note.content|raw }}
  {%~ else %}
  {%~ if note.intro %}
  {{ note.intro|raw }}
  {%~ endif %}
  {%~ for item in note.items %}
  <section class="note-tab" id="{{ note.id|e }}-{{ loop.index }}">
    {%~ if item.heading %}
    {{ item.heading|raw }}
    {%~ else %}
    <p class="note-tab-title">{{ item.title|raw }}</p>
    {%~ endif %}
    {{ item.content|raw }}
  </section>
  {%~ endfor %}
  {%~ endif %}
</div>